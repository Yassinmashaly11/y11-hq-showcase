# Copy this file to .env and fill it in.
DATABASE_URL=postgres://localhost:5432/y11hq
# Long random string used to sign login tokens. Change it before going live.
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Your CEO login, created by `npm run db:seed`
OWNER_USERNAME=yassin
OWNER_PASSWORD=change-me
# Set to true to load fake associates and sales for testing
SEED_DEMO_DATA=true
# Separate empty database for `npm test` (create it once: createdb y11hq_test)
TEST_DATABASE_URL=postgres://localhost:5432/y11hq_test
# Shared key for the Y11 website's backend (Lovable) to read stock and check codes.
# Make one with: openssl rand -hex 32   Leave it out until you connect the website.
# WEBSITE_API_KEY=
# Record Stripe test-mode website orders (only while testing).
# WEBSITE_TEST_ORDERS=true
# Email each new website order to you through resend.com (optional).
# RESEND_API_KEY=
# ORDER_EMAIL_TO=you@example.com
